{
  "expo": {
    "name": "XU Wallet",
    "slug": "xu-wallet",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "xuwallet",
    "userInterfaceStyle": "light",
    "icon": "./assets/xu-icon.svg",
    "splash": {
      "image": "./assets/xu-splash.svg",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.xuwallet.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "XU Wallet uses Face ID to unlock your wallet securely.",
        "NSCameraUsageDescription": "XU Wallet uses the camera to scan QR codes."
      }
    },
    "android": {
      "package": "com.xuwallet.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/xu-icon.svg",
        "backgroundColor": "#6C4CF1"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": { "bundler": "metro", "output": "static" },
    "plugins": [
      ["expo-router", { "root": "./app" }],
      ["expo-splash-screen", {
        "image": "./assets/xu-splash.svg",
        "imageWidth": 180,
        "resizeMode": "contain",
        "backgroundColor": "#FFFFFF"
      }],
      ["expo-local-authentication", {
        "faceIDPermission": "XU Wallet uses Face ID to unlock your wallet securely."
      }],
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": { "typedRoutes": true },
    "extra": {
      "router": {},
      "eas": { "projectId": "9e96fad3-bc39-49d9-b5a7-ae16531c425c" }
    }
  }
}